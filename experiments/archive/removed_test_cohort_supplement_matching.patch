+    def test_supplement_matches_saved_selections_when_country_labels_changed(self):
+        from crop_pipeline.common import save_json
+        from crop_pipeline.sources import adaptive
+
+        def feature(group, country, geometry, dataset="jecam"):
+            return {"geometry": mapping(geometry), "properties": {
+                "partition_group": group, "parcel_id": group, "country": country,
+                "source_dataset": dataset, "crop": "carrot",
+            }}
+
+        # Saved before country boundaries were used ("jecam"); current references say "Madagascar".
+        saved = feature("jecam:1", "jecam", box(0, 0, 2, 2))
+        current = feature("jecam:1", "Madagascar", box(0, 0, 2, 2))
+        overlapping = feature("idf:1", "France", box(1, 1, 3, 3), "ile-de-france")
+        with TemporaryDirectory() as tmp:
+            report = Path(tmp) / "inventory"
+            campaign = adaptive.root(report, test_cohort.TEST_POLICY)
+            save_json(campaign / "rounds/0001/primary/selection.json",
+                      {"physical_keys": [adaptive.physical_key("cropharvest", saved["properties"])]})
+            with patch.object(test_cohort, "completed_sources", return_value=[]), \
+                    patch.object(adaptive, "prepare_round_batches") as prepare:
+                test_cohort.prepare_carrot_potato_supplement(report, Path(tmp), [current, overlapping], {}, 50)
+            self.assertEqual(prepare.call_args.args[1], [])  # the overlapping parcel is still screened out
+            missing = feature("jecam:2", "jecam", box(8, 8, 9, 9))
+            save_json(campaign / "rounds/0001/other/selection.json",
+                      {"physical_keys": [adaptive.physical_key("cropharvest", missing["properties"])]})
+            with patch.object(test_cohort, "completed_sources", return_value=[]), self.assertRaises(ValueError):
+                test_cohort.prepare_carrot_potato_supplement(report, Path(tmp), [current, overlapping], {}, 50)
+
